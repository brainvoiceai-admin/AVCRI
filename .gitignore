# --- Environment Files ---
# Ignore sensitive data and local environment configurations.
.env.*
.env*

db.sqlite3
# --- Databases ---
# Ignore the local development database.

# --- Django ---
# Ignore user-uploaded files, collected static files, and logs.
/media/
*.log

# --- Python ---
# Ignore Python's generated bytecode, cache, and virtual environments.
__pycache__/
*.pyc
venv/
env/
.venv/

# --- IDE & Editor Config ---
# Ignore settings specific to a developer's editor.
.vscode/
.idea/

# --- Operating System Files ---
# Ignore system-specific metadata files.
.DS_Store
Thumbs.db
